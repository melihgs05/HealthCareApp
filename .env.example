# ============================================================
# CareBridge — Environment Variables
# Copy this file to .env and fill in YOUR values.
# ============================================================

# ── Option A: Neon PostgreSQL (recommended for new setups) ──────────────────
# 1. Create a free project at https://console.neon.tech
# 2. Go to Project → Connection Details → Connection String
# 3. Paste the full connection string below (include ?sslmode=require)
VITE_NEON_DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# After setting VITE_NEON_DATABASE_URL, run neon-schema.sql in Neon's SQL Editor
# to create all tables and seed default data.


# ── Option B: Supabase (if you have an existing Supabase project) ────────────
# Leave these commented out if you are using Neon above.
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here


# ── Neither set = always Demo Mode ──────────────────────────────────────────
# If none of the above are configured the app always runs in demo mode
# and the admin toggle will be disabled.


# ── Email (Resend + Supabase Edge Function) ───────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Verify your sending domain (or use @resend.dev for testing)
# 3. Create an API key in Resend dashboard
# 4. Deploy the Edge Function:  supabase functions deploy send-email --no-verify-jwt
# 5. Set the secret:            supabase secrets set RESEND_API_KEY=re_xxxx
# 6. Optionally set:            supabase secrets set FROM_EMAIL="CareBridge <noreply@yourdomain.com>"
# 7. Then fill in the values below:
VITE_EMAIL_API_URL=https://<project-ref>.supabase.co/functions/v1/send-email
VITE_EMAIL_FROM=CareBridge <noreply@yourdomain.com>
VITE_APP_URL=https://yourapp.com


# ── Google OAuth ───────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized JavaScript origins: https://yourapp.com
# 4. Add Authorized redirect URIs:      https://yourapp.com/oauth/callback
# 5. Copy the Client ID (you do NOT need the client secret for this flow)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
